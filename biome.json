{
	"$schema": "https://biomejs.dev/schemas/2.2.7/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"app",
			"app/",
			"app/*",
			"!node_modules/",
			"!dist/",
			"!.convex/",
			"!.next/",
			"!convex/_generated",
			"!convex/_generated/*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noMagicNumbers": "off",
				"noNestedTernary": "off",
				"useNumericSeparators": "off",
				"useBlockStatements": "off",
				"useFilenamingConvention": "off"
			},
			"suspicious": {
				"noTsIgnore": "off",
				"noConsole": "off",
				"useAwait": "off",
				"noExplicitAny": "off",
				"noUnknownAtRules": "off"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off"
			},
			"a11y": {
				"useSemanticElements": "off"
			},
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
